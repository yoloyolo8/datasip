# ====================================
# DataSip 环境变量配置模板
# ====================================
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 填入真实的配置值
# 3. .env 文件不会被提交到 Git（已在 .gitignore 中配置）

# VPS 公网 IP
VPS_IP=your_vps_public_ip

# ====================================
# Telegram 配置
# ====================================
# 从 @BotFather 获取 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 允许使用 Bot 的 Telegram User IDs（逗号分隔）
# 发送消息给 @userinfobot 获取您的 User ID
ALLOWED_USER_IDS=your_telegram_user_id

# ====================================
# PostgreSQL 数据库
# ====================================
POSTGRES_USER=datasip
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=datasip

# ====================================
# N8N 工作流引擎
# ====================================
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# N8N 加密密钥（随机生成32字符）
# 生成命令: openssl rand -hex 16
N8N_ENCRYPTION_KEY=your_random_32_char_encryption_key

# N8N API Token（在 N8N UI 中生成）
# Settings → API → Create API Key
N8N_api_token=your_n8n_api_token_here

# ====================================
# N8N Webhook 配置
# ====================================
# 使用域名而非 IP（Cloudflare Workers 限制）
N8N_WEBHOOK_URL=http://n8n.yourdomain.com:5678/webhook/datasip-webhook

# Webhook 安全密钥（随机生成）
# 生成命令: openssl rand -base64 24
N8N_WEBHOOK_SECRET=your_webhook_secret_here

# ====================================
# LLM API Keys
# ====================================

# Portkey（可选，用于 LLM 网关）
PORTKEY_API_KEY_user=your_portkey_user_key
PORTKEY_API_KEY_service=your_portkey_service_key

# Gemini API（可选）
# 从 https://makersuite.google.com/app/apikey 获取
GEMINI_API_KEY=your_gemini_api_key

# Claude API（可选）
# 从 https://console.anthropic.com/ 获取
CLAUDE_API_KEY=your_claude_api_key

# OpenRouter API（推荐，当前使用）
# 从 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=your_openrouter_api_key

# ====================================
# Cloudflare Workers
# ====================================
# 从 Cloudflare Dashboard 创建 API Token
# 需要权限: Workers Scripts (Edit), Workers Routes (Edit), User Details (Read)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# 环境标识
ENVIRONMENT=production
