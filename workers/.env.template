# Cloudflare API Token (for wrangler deployment)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# N8N Webhook URL (your VPS IP + webhook path)
N8N_WEBHOOK_URL=http://your_vps_ip:5678/webhook/datasip-webhook

# N8N Webhook Secret (random string for authentication)
N8N_WEBHOOK_SECRET=your_random_secret_32chars

# Allowed Telegram User IDs (comma separated)
ALLOWED_USER_IDS=your_telegram_user_id
