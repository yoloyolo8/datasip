      "id": "is-daily-match",
      "name": "Is Daily Match?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "operation": "select",
        "query": "SELECT * FROM intentions WHERE status = 'open' ORDER BY priority DESC, created_at DESC LIMIT 20",
        "options": {}
      },
      "id": "get-open-intentions",
      "name": "Get Open Intentions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [690, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "select",
        "query": "=SELECT * FROM data_inbox WHERE created_at > NOW() - INTERVAL '7 days' AND (title ILIKE '%' || '{{ $json.content.split(' ')[0] }}' || '%' OR summary ILIKE '%' || '{{ $json.content.split(' ')[0] }}' || '%') LIMIT 5",
        "options": {}
      },
      "id": "search-related",
      "name": "Search Related Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [910, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-matches",
      "name": "Has Matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openai/gpt-4o-mini',\n  messages: [\n    {\n      role: 'user',\n      content: '用户的问题: ' + $('Get Open Intentions').item.json.content + '\\n\\n找到的相关内容:\\n' + JSON.stringify($json.slice(0, 3).map(d => ({ title: d.title, summary: d.summary }))) + '\\n\\n请判断这些内容是否能帮助回答用户的问题。\\n返回JSON: {\"is_relevant\": true/false, \"relevance_score\": 0-1, \"summary\": \"如何回答问题的简要说明\"}'\n    }\n  ],\n  response_format: { type: 'json_object' }\n}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "judge-relevance",
      "name": "Judge Relevance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 100]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst digest = [];\n\nfor (const item of items) {\n  try {\n    const result = JSON.parse(item.json.choices[0].message.content);\n    if (result.is_relevant && result.relevance_score > 0.6) {\n      digest.push({\n        intention: $('Get Open Intentions').first().json.content,\n        intention_id: $('Get Open Intentions').first().json.id,\n        relevance_score: result.relevance_score,\n        summary: result.summary\n      });\n    }\n  } catch (e) {\n    // ignore parse errors\n  }\n}\n\nreturn { digest, has_content: digest.length > 0 };"
      },
      "id": "build-digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1570, 100]
    },
    {
      "parameters": {},
      "id": "no-op-end",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1130, 400]
    }
  ],
