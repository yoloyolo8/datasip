    },
    {
      "parameters": {
        "operation": "select",
        "query": "SELECT id, content, created_at, priority FROM intentions WHERE status = 'open' ORDER BY priority DESC, created_at DESC LIMIT 10",
        "options": {}
      },
      "id": "list-intentions",
      "name": "List Intentions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [910, 100],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst webhook = $('Webhook').first().json;\n\nif (items.length === 0) {\n  return { text: '📭 暂无待解决的问题', chat_id: webhook.body.telegram.chat_id };\n}\n\nlet text = '📋 <b>待解决问题列表</b>\\n\\n';\nitems.forEach((item, i) => {\n  const d = item.json;\n  const shortId = d.id.substring(0, 8);\n  const date = new Date(d.created_at).toLocaleDateString('zh-CN');\n  text += `${i + 1}. [${shortId}] ${d.content}\\n   📅 ${date} | ⭐ ${d.priority}\\n\\n`;\n});\n\ntext += '使用 /resolve <id> 标记为已解决';\n\nreturn { text, chat_id: webhook.body.telegram.chat_id };"
      },
      "id": "format-list",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 100]
    },
    {
      "parameters": {
        "operation": "update",
        "query": "=UPDATE intentions SET status = 'resolved', resolved_at = NOW() WHERE id LIKE '{{ $('Webhook').item.json.body.command.args }}%' RETURNING id, content",
        "options": {}
      },
      "id": "resolve-intention",
      "name": "Resolve Intention",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [910, 250],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst webhook = $('Webhook').first().json;\n\nif (items.length === 0) {\n  return { text: '❌ 未找到该问题ID', chat_id: webhook.body.telegram.chat_id };\n}\n\nconst d = items[0].json;\nreturn {\n  text: `✅ 已标记为解决\\n\\n问题: ${d.content}\\nID: ${d.id.substring(0, 8)}`,\n  chat_id: webhook.body.telegram.chat_id\n};"
      },
      "id": "format-resolve",
      "name": "Format Resolve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 250]
    },
    {
      "parameters": {
        "operation": "select",
        "query": "SELECT name, source_type, status, total_items FROM source_list ORDER BY total_items DESC LIMIT 10",
        "options": {}
      },
      "id": "list-sources",
      "name": "List Sources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [910, 400],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst webhook = $('Webhook').first().json;\n\nif (items.length === 0) {\n  return { text: '📭 暂无订阅源', chat_id: webhook.body.telegram.chat_id };\n}\n\nlet text = '📡 <b>订阅源列表</b>\\n\\n';\nitems.forEach((item, i) => {\n  const d = item.json;\n  const icon = d.source_type === 'youtube' ? '🎬' : '📰';\n  const status = d.status === 'active' ? '✅' : '⏸️';\n  text += `${icon} ${d.name}\\n   ${status} ${d.source_type} | 📊 ${d.total_items} 条\\n\\n`;\n});\n\nreturn { text, chat_id: webhook.body.telegram.chat_id };"
      },
      "id": "format-sources",
      "name": "Format Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 400]
    },
    {
      "parameters": {
        "operation": "select",
        "query": "SELECT (SELECT COUNT(*) FROM intentions WHERE status = 'open') as open_intentions, (SELECT COUNT(*) FROM intentions WHERE status = 'resolved') as resolved_intentions, (SELECT COUNT(*) FROM data_inbox) as total_data, (SELECT COUNT(*) FROM source_list WHERE status = 'active') as active_sources",
        "options": {}
      },
      "id": "get-stats",
      "name": "Get Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [910, 550],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "DataSip PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stats = $input.first().json;\nconst webhook = $('Webhook').first().json;\n\nconst text = `📊 <b>DataSip 统计</b>\\n\\n` +\n  `❓ 待解决问题: ${stats.open_intentions}\\n` +\n  `✅ 已解决问题: ${stats.resolved_intentions}\\n` +\n  `📚 存储内容: ${stats.total_data}\\n` +\n  `📡 活跃订阅源: ${stats.active_sources}`;\n\nreturn { text, chat_id: webhook.body.telegram.chat_id };"
      },
      "id": "format-stats",
      "name": "Format Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chat_id }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            }
          ]
        },
        "options": {}
      },
