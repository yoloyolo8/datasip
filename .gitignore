# ====================================
# DataSip Project .gitignore
# ====================================

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local
docker/.env
workers/.env

# 但保留模板文件
!.env.example
!docker/.env.example
!workers/.env.template

# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建输出
dist/
build/
.next/
out/

# 日志文件
*.log
logs/

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
*.tmp
*.temp
.cache/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# Cloudflare Workers
.wrangler/
wrangler.toml.backup

# 测试覆盖率
coverage/
.nyc_output/

# 备份文件
*.backup
*.bak
*.old

# 敏感文档（如果有）
secrets/
private/

# N8N 备份（可能包含凭据）
n8n-backup-*.json
